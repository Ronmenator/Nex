// GPT-2 Small (124M) — Nex + libtorch
//
// Architecture (Pre-LayerNorm GPT-2):
//   Token Embedding + Position Embedding + Embedding RMSNorm
//   -> N x [ RMSNorm -> Q/K/V LinearNoBias -> SDPA -> O LinearNoBias + Residual
//            -> RMSNorm -> FFN(LinearNoBias, GELU, LinearNoBias) + Residual ]
//   -> Final RMSNorm -> LM Head (LinearNoBias)
//
// Module system handles leaf layers (tok_emb, pos_emb, emb_norm, ln_f, lm_head)
// with automatic device management and optimizer setup.
// Transformer blocks use Lists (need 12 separate instances).
//
// Usage:
//   nex run examples/gpt2_transformer
//
// Requires: data/train.txt in the working directory

import torch.tensor
import torch.nn
import torch.optim

// ============================================================================
// FFI arithmetic workarounds
// ============================================================================

// Cranelift misidentifies register types for torch DLL returns used in
// arithmetic. Wrapping in a trivial function forces a function boundary
// that resets type tracking.
def wrap_int(v: Int) -> Int { return v }
def wrap_float(v: Float) -> Float { return v }

// ============================================================================
// GPT module — 5 leaf layers (singleton, auto to_device/setup_optimizer)
// ============================================================================

module GPT(vocab: Int, n_embd: Int, seq_len: Int) {
    [Optim("adamw", "lr=6e-4", "beta1=0.9", "beta2=0.95", "wd=0.1")]
    tok_emb:  Embedding(vocab, n_embd)
    [Optim("adamw", "lr=6e-4", "beta1=0.9", "beta2=0.95", "wd=0.1")]
    pos_emb:  Embedding(seq_len, n_embd)
    [Optim("adamw", "lr=6e-4", "beta1=0.9", "beta2=0.95", "wd=0.1")]
    emb_norm: RMSNorm(n_embd)
    [Optim("adamw", "lr=6e-4", "beta1=0.9", "beta2=0.95", "wd=0.1")]
    ln_f:     RMSNorm(n_embd)
    [Optim("adamw", "lr=6e-4", "beta1=0.9", "beta2=0.95", "wd=0.1")]
    lm_head:  LinearNoBias(n_embd, vocab)

    def forward(blocks: List, tokens: Int, pos: Int,
                B: Int, T: Int, H: Int, D: Int, n_layer: Int) -> Int {
        var tok = self.tok_emb(tokens)
        var pe  = self.pos_emb(pos)
        var x   = tensor_add(tok, pe)
        tensor_free(tok)
        tensor_free(pe)
        var xn = self.emb_norm(x)
        tensor_free(x)
        x = xn

        var bi = 0
        while (bi < n_layer) {
            var x_new = block_forward(list_get(blocks, bi), x, B, T, H, D)
            tensor_free(x)
            x = x_new
            bi = bi + 1
        }

        var xf = self.ln_f(x)
        tensor_free(x)
        var logits = self.lm_head(xf)
        tensor_free(xf)
        return logits
    }

    def leaf_modules() -> List {
        var mods = list_new()
        list_push(mods, self.tok_emb)
        list_push(mods, self.pos_emb)
        list_push(mods, self.emb_norm)
        list_push(mods, self.ln_f)
        list_push(mods, self.lm_head)
        return mods
    }
}

// ============================================================================
// Transformer block — 7 modules per block (12 instances via Lists)
// ============================================================================

def make_block(n_embd: Int, mlp_hidden: Int) -> List {
    var parts = list_new()

    var ln1 = nn_sequential_new()
    nn_rms_norm(ln1, n_embd)
    list_push(parts, ln1)

    var qp = nn_sequential_new()
    nn_linear_no_bias(qp, n_embd, n_embd)
    list_push(parts, qp)

    var kp = nn_sequential_new()
    nn_linear_no_bias(kp, n_embd, n_embd)
    list_push(parts, kp)

    var vp = nn_sequential_new()
    nn_linear_no_bias(vp, n_embd, n_embd)
    list_push(parts, vp)

    var op = nn_sequential_new()
    nn_linear_no_bias(op, n_embd, n_embd)
    list_push(parts, op)

    var ln2 = nn_sequential_new()
    nn_rms_norm(ln2, n_embd)
    list_push(parts, ln2)

    var mlp = nn_sequential_new()
    nn_linear_no_bias(mlp, n_embd, mlp_hidden)
    nn_gelu(mlp)
    nn_linear_no_bias(mlp, mlp_hidden, n_embd)
    list_push(parts, mlp)

    return parts
}

def make_blocks(n_layer: Int, n_embd: Int, mlp_hidden: Int) -> List {
    var blocks = list_new()
    var i = 0
    while (i < n_layer) {
        list_push(blocks, make_block(n_embd, mlp_hidden))
        i = i + 1
    }
    return blocks
}

def block_forward(block: List, x: Int, B: Int, T: Int, H: Int, D: Int) -> Int {
    var xn = nn_forward(list_get(block, 0), x)

    var q_lin = nn_forward(list_get(block, 1), xn)
    var q_v4  = tensor_view4(q_lin, B, T, H, D)
    tensor_free(q_lin)
    var q = tensor_transpose(q_v4, 1, 2)
    tensor_free(q_v4)

    var k_lin = nn_forward(list_get(block, 2), xn)
    var k_v4  = tensor_view4(k_lin, B, T, H, D)
    tensor_free(k_lin)
    var k = tensor_transpose(k_v4, 1, 2)
    tensor_free(k_v4)

    var v_lin = nn_forward(list_get(block, 3), xn)
    var v_v4  = tensor_view4(v_lin, B, T, H, D)
    tensor_free(v_lin)
    var v = tensor_transpose(v_v4, 1, 2)
    tensor_free(v_v4)

    tensor_free(xn)

    var attn_raw = tensor_sdpa(q, k, v, 1)
    tensor_free(q)
    tensor_free(k)
    tensor_free(v)
    var attn_t = tensor_transpose(attn_raw, 1, 2)
    tensor_free(attn_raw)
    var attn_c = tensor_contiguous(attn_t)
    tensor_free(attn_t)
    var attn = tensor_view3(attn_c, B, T, H * D)
    tensor_free(attn_c)

    var out_proj = nn_forward(list_get(block, 4), attn)
    tensor_free(attn)
    var x1 = tensor_add(x, out_proj)
    tensor_free(out_proj)

    var ln2_out = nn_forward(list_get(block, 5), x1)
    var mlp_out = nn_forward(list_get(block, 6), ln2_out)
    tensor_free(ln2_out)
    var x2 = tensor_add(x1, mlp_out)
    tensor_free(mlp_out)
    tensor_free(x1)
    return x2
}

// ============================================================================
// Block helpers
// ============================================================================

def blocks_to_cuda(blocks: List) {
    var bi = 0
    while (bi < list_len(blocks)) {
        var block = list_get(blocks, bi)
        var j = 0
        while (j < list_len(block)) {
            nn_to_device(list_get(block, j), "cuda")
            j = j + 1
        }
        bi = bi + 1
    }
}

def make_block_optims(blocks: List, lr: Float) -> List {
    var opts = list_new()
    var bi = 0
    while (bi < list_len(blocks)) {
        var block = list_get(blocks, bi)
        var j = 0
        while (j < list_len(block)) {
            list_push(opts, optim_adamw(list_get(block, j), lr, 0.9, 0.95, 0.1))
            j = j + 1
        }
        bi = bi + 1
    }
    return opts
}

def collect_block_mods(blocks: List) -> List {
    var mods = list_new()
    var bi = 0
    while (bi < list_len(blocks)) {
        var block = list_get(blocks, bi)
        var j = 0
        while (j < list_len(block)) {
            list_push(mods, list_get(block, j))
            j = j + 1
        }
        bi = bi + 1
    }
    return mods
}

// ============================================================================
// Training helpers
// ============================================================================

def set_lr_all(opts: List, lr: Float) {
    var i = 0
    while (i < list_len(opts)) {
        optim_set_lr(list_get(opts, i), lr)
        i = i + 1
    }
}

def step_all(opts: List) {
    var i = 0
    while (i < list_len(opts)) {
        optim_step_and_zero(list_get(opts, i))
        i = i + 1
    }
}

def clip_all(mods: List) {
    var i = 0
    while (i < list_len(mods)) {
        nn_clip_grad_norm(list_get(mods, i), 1.0)
        i = i + 1
    }
}

// ============================================================================
// Data loading
// ============================================================================

def load_data() -> Int {
    var text = file_read_all("data/train.txt")
    println("  " + str_length(text) + " bytes")
    return tensor_from_string_bytes(text)
}

def get_batch(data: Int, batch_size: Int, seq_len: Int) -> Int {
    var n = wrap_int(tensor_shape_dim(data, 0)) - seq_len - 2
    var rows = list_new()
    var i = 0
    while (i < batch_size) {
        list_push(rows, tensor_narrow(data, 0, random_range(0, n), seq_len + 1))
        i = i + 1
    }
    return tensor_stack(rows, 0)
}

// ============================================================================
// Train step
// ============================================================================

// Returns 0 (Int return required to avoid void-function codegen issue).
def do_step(blocks: List, data: Int, pos: Int, opts: List, all_mods: List,
            B: Int, T: Int, H: Int, D: Int, n_layer: Int, step: Int, do_log: Int) -> Int {
    var batch   = get_batch(data, B, T)
    batch       = tensor_to_device(batch, "cuda")
    var inputs  = tensor_narrow(batch, 1, 0, T)
    var targets = tensor_narrow(batch, 1, 1, T)

    var logits      = GPT.forward(blocks, inputs, pos, B, T, H, D, n_layer)
    var flat_logits  = tensor_flatten(logits, 0, 1)
    var flat_targets = tensor_to_dtype_long(tensor_flatten(targets, 0, 1))
    var loss = loss_cross_entropy(flat_logits, flat_targets)
    tensor_backward(loss)

    if (do_log == 1) {
        println("  step=" + step + "  loss=")
        tensor_print(loss)
    }

    clip_all(all_mods)
    step_all(opts)

    tensor_free(loss)
    tensor_free(flat_logits)
    tensor_free(flat_targets)
    tensor_free(logits)
    tensor_free(inputs)
    tensor_free(targets)
    tensor_free(batch)
    return 0
}

// ============================================================================
// Main
// ============================================================================

def main() {
    println("=== Nex GPT-2 Small (124M) ===")

    // Hyperparameters
    var vocab     = 256
    var n_embd    = 768
    var n_head    = 12
    var head_dim  = 64
    var n_layer   = 12
    var seq_len   = 1024
    var mlp_hidden = 3072
    var batch_size = 4
    var max_lr    = 6e-4
    var min_lr    = 6e-5
    var total_steps = 50
    var warmup    = 200
    var log_every = 10

    // Load training data
    println("Loading data...")
    var data = load_data()

    // Build model
    println("Building model...")
    GPT(vocab, n_embd, seq_len)
    var blocks = make_blocks(n_layer, n_embd, mlp_hidden)
    println("  " + (5 + n_layer * 7) + " modules")

    // Move to GPU
    println("Moving to CUDA...")
    GPT.to_device("cuda")
    blocks_to_cuda(blocks)

    var pos = tensor_to_device(
        tensor_to_dtype_long(tensor_arange(0.0, seq_len * 1.0, 1.0)), "cuda")

    // Create AdamW optimizers
    println("Creating optimizers...")
    var gpt_opts   = GPT.setup_optimizer()
    var block_opts = make_block_optims(blocks, max_lr)

    var opts = list_new()
    var oi = 0
    while (oi < list_len(gpt_opts)) {
        list_push(opts, list_get(gpt_opts, oi))
        oi = oi + 1
    }
    oi = 0
    while (oi < list_len(block_opts)) {
        list_push(opts, list_get(block_opts, oi))
        oi = oi + 1
    }
    println("  " + list_len(opts) + " AdamW optimizers")

    // Collect all module handles for gradient clipping
    var all_mods   = GPT.leaf_modules()
    var block_mods = collect_block_mods(blocks)
    var mi = 0
    while (mi < list_len(block_mods)) {
        list_push(all_mods, list_get(block_mods, mi))
        mi = mi + 1
    }

    // Training loop
    println("Training...")
    var step = 0
    var t0   = wrap_int(now_millis())

    while (step < total_steps) {
        // Cosine LR schedule with warmup
        var lr = max_lr
        if (step >= warmup) {
            var progress = wrap_float((step - warmup) * 1.0 / (total_steps - warmup) * 1.0)
            var pi = 3.141592653589793
            lr = wrap_float(min_lr + (max_lr - min_lr) * 0.5 * (1.0 + wrap_float(cos(pi * progress))))
        }
        if (step < warmup) {
            lr = wrap_float(max_lr * (step * 1.0 / warmup * 1.0))
        }
        set_lr_all(opts, lr)

        var do_log = 0
        if (step % log_every == 0) { do_log = 1 }

        do_step(blocks, data, pos, opts, all_mods,
                batch_size, seq_len, n_head, head_dim, n_layer, step, do_log)

        if (step % log_every == 0) {
            var t1 = wrap_int(now_millis())
            var ms = wrap_float((t1 - t0) * 1.0 / log_every * 1.0)
            if (step == 0) { ms = wrap_float((t1 - t0) * 1.0) }
            println("    lr=" + lr + "  ms/step=" + ms)
            t0 = t1
        }
        step = step + 1
    }
    println("Done!")
}
