// torch.train — High-level training utilities.
// Combines forward pass, loss computation, backpropagation, and optimizer step.

// Performs a single training step with MSE loss.
// Returns the loss tensor handle (use item_float to read the scalar value).
public def train_step_mse(model: Int64, optimizer: Int64, input: Int64, target: Int64) -> Int64 {
    optim_zero_grad(optimizer)
    output = nn_forward(model, input)
    loss = loss_mse(output, target)
    tensor_backward(loss)
    optim_step(optimizer)
    return loss
}

// Performs a single training step with cross-entropy loss.
// Returns the loss tensor handle (use item_float to read the scalar value).
public def train_step_ce(model: Int64, optimizer: Int64, input: Int64, target: Int64) -> Int64 {
    optim_zero_grad(optimizer)
    output = nn_forward(model, input)
    loss = loss_cross_entropy(output, target)
    tensor_backward(loss)
    optim_step(optimizer)
    return loss
}

// Performs a single training step: backward, optional gradient clipping,
// optimizer step + zero_grad for all optimizers.
public def train_step(loss: Int64, optims: List, clip_norm: Float) {
    tensor_backward(loss)
    if (clip_norm > 0.0) {
        var i = 0
        while (i < optims.len()) {
            nn_scale_gradients(optims.get(i), clip_norm)
            i = i + 1
        }
    }
    var j = 0
    while (j < optims.len()) {
        optim_step_and_zero(optims.get(j))
        j = j + 1
    }
    return
}

// Gradient accumulation step: scales gradients by 1/accum_steps then steps.
public def train_step_accumulated(loss: Int64, optims: List, accum_steps: Int) {
    tensor_backward(loss)
    var scale = 1.0 / (accum_steps * 1.0)
    var i = 0
    while (i < optims.len()) {
        nn_scale_gradients(optims.get(i), scale)
        optim_step_and_zero(optims.get(i))
        i = i + 1
    }
    return
}
